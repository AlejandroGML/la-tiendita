# ═══════════════════════════════════════════════════════════════════
# La Tiendita — Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# Copy to backend/.env and fill in real values.
# Generate a secure SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# ═══════════════════════════════════════════════════════════════════

# ── REQUIRED (no defaults) ────────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db_name
SECRET_KEY=<generate-with-python3>

# ── APP ───────────────────────────────────────────────────────────

DEBUG=false
CORS_ORIGINS=["http://localhost:4200"]
FRONTEND_URL=http://localhost:4200

# ── JWT ───────────────────────────────────────────────────────────

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OAUTH (Google) ────────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4200/auth/google/callback

# ── RATE LIMITING ─────────────────────────────────────────────────

RATE_LIMIT_REQUESTS=20   # requests per window per IP
RATE_LIMIT_WINDOW=60     # sliding window in seconds

# ── IMAGE UPLOAD ──────────────────────────────────────────────────

UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE=5242880   # 5 MB in bytes
MAX_IMAGE_DIMENSION=1200 # px

# ── STRIPE ────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── EMAIL ─────────────────────────────────────────────────────────
# EMAIL_MODE: "log" (console), "smtp" (relay), or "resend" (Resend API)

EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=noreply@latiendita.local

# ── REDIS / CACHE ─────────────────────────────────────────────────
# CACHE_ENABLED=false disables the cache layer entirely (reads fall to DB).

REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_PREFIX=tiendita
CACHE_TTL_PRODUCTS_LIST=60
CACHE_TTL_PRODUCT_DETAIL=300
CACHE_TTL_CATEGORIES_LIST=600
CACHE_TTL_PROMOTIONS_ACTIVE=120

# ── BACKGROUND JOBS (ARQ) ─────────────────────────────────────────

ARQ_QUEUE_NAME=arq:queue

# ── SENTRY ERROR TRACKING (optional) ──────────────────────────────
# Leave empty to disable. Get your DSN at https://sentry.io
# SENTRY_DSN=https://xxxxxxxxxxx@xxxxxx.ingest.sentry.io/xxxxxx
